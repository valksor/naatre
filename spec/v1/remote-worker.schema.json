{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naatre.dev/spec/v1/remote-worker.schema.json",
  "title": "Naatre remote worker v1 envelopes",
  "oneOf": [
    {"$ref": "#/$defs/registration"},
    {"$ref": "#/$defs/invocation"},
    {"$ref": "#/$defs/result"},
    {"$ref": "#/$defs/cancellation"}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handler": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "inputSchema", "outputSchema", "codec", "effect", "requiredCapabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"}, "inputSchema": {"$ref": "#/$defs/identifier"}, "outputSchema": {"$ref": "#/$defs/identifier"},
        "codec": {"const": "naatre.json-1"}, "effect": {"enum": ["query", "mutation", "transaction", "subscription"]},
        "requiredCapabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "registration": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "workerId", "serviceIdentity", "audience", "endpoint", "schemaRevision", "schemaDigest", "capabilities", "limits", "handlers"],
      "properties": {
        "protocol": {"const": "naatre.remote-worker.v1"}, "workerId": {"$ref": "#/$defs/identifier"}, "serviceIdentity": {"type": "string", "minLength": 1, "maxLength": 2048},
        "audience": {"$ref": "#/$defs/identifier"}, "endpoint": {"$ref": "#/$defs/identifier"}, "schemaRevision": {"$ref": "#/$defs/identifier"}, "schemaDigest": {"$ref": "#/$defs/digest"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "limits": {"type": "object", "additionalProperties": false, "required": ["maxInFlight", "maxRequestBytes", "maxResponseBytes", "maxStreamFrames", "maxStreamBytes"], "properties": {"maxInFlight": {"type": "integer", "minimum": 1}, "maxRequestBytes": {"type": "integer", "minimum": 1}, "maxResponseBytes": {"type": "integer", "minimum": 1}, "maxStreamFrames": {"type": "integer", "minimum": 1}, "maxStreamBytes": {"type": "integer", "minimum": 1}}},
        "handlers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/handler"}}
      }
    },
    "parent": {"type": "object", "additionalProperties": false, "properties": {"value": true, "reference": {"$ref": "#/$defs/identifier"}, "ownerInvocationId": {"$ref": "#/$defs/identifier"}}, "oneOf": [{"required": ["value"]}, {"required": ["reference", "ownerInvocationId"]}]},
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "requestId", "invocationId", "attemptId", "handlerId", "schemaRevision", "deadlineUnixMilli", "delegatedContext", "input"],
      "properties": {"protocol": {"const": "naatre.remote-worker.v1"}, "requestId": {"$ref": "#/$defs/identifier"}, "invocationId": {"$ref": "#/$defs/identifier"}, "attemptId": {"$ref": "#/$defs/identifier"}, "handlerId": {"$ref": "#/$defs/identifier"}, "schemaRevision": {"$ref": "#/$defs/identifier"}, "deadlineUnixMilli": {"type": "integer"}, "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 1024}, "delegatedContext": {"type": "string", "minLength": 1, "maxLength": 8192}, "parent": {"$ref": "#/$defs/parent"}, "input": true, "resumeCursor": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}, "message": {"type": "string", "minLength": 1, "maxLength": 32768}, "retryable": {"type": "boolean"}, "details": {"type": "object"}}},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "invocationId", "attemptId", "schemaRevision", "data", "errors"],
      "properties": {"protocol": {"const": "naatre.remote-worker.v1"}, "invocationId": {"$ref": "#/$defs/identifier"}, "attemptId": {"$ref": "#/$defs/identifier"}, "schemaRevision": {"$ref": "#/$defs/identifier"}, "data": true, "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}, "references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "expiresAt", "lifetime"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "expiresAt": {"type": "string", "format": "date-time"}, "lifetime": {"enum": ["invocation", "request"]}}}}}
    },
    "cancellation": {"type": "object", "additionalProperties": false, "required": ["protocol", "requestId", "invocationId"], "properties": {"protocol": {"const": "naatre.remote-worker.v1"}, "requestId": {"$ref": "#/$defs/identifier"}, "invocationId": {"$ref": "#/$defs/identifier"}}}
  }
}
