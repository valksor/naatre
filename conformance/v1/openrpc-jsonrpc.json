  "directions": ["schema-import", "schema-export", "runtime-consume", "runtime-expose"],
  "fidelity": [
    {"feature":"batch","classification":"explicitly-adapted","evidence":"bounded mixed batches preserve request IDs and independent member outcomes"},
    {"feature":"notification","classification":"explicitly-adapted","evidence":"per-method application approval is required and no response is emitted"},
    {"feature":"id","classification":"lossless","evidence":"absent, null, string, zero, and integral numeric IDs remain distinct"},
    {"feature":"result-error","classification":"explicitly-adapted","evidence":"exactly one result or error member is accepted"},
    {"feature":"scalar","classification":"lossless","evidence":"scalar result JSON and decimal-string extended integers are retained"},
    {"feature":"deadline","classification":"explicitly-adapted","evidence":"the caller context propagates without deadline extension"},
    {"feature":"authentication","classification":"application-supplied","evidence":"one explicit callback mutates the exact request and no cookie jar is used"},
    {"feature":"effects-policy","classification":"application-supplied","evidence":"runtime descriptors provide effect, idempotency, retry, cache, cost, batching, transaction, and authorization policy"},
    {"feature":"unsupported-schema","classification":"explicitly-adapted","evidence":"unknown keywords, remote references, cycles, ambiguous oneOf, and positional parameters reject mapping"}
  ],
  "fixtureClasses": {
    "positive": ["description-import-export", "client-scalar-call", "handler-call", "mixed-batch", "approved-notification"],
    "negative": ["wrong-openrpc-revision", "unknown-description-field", "unapproved-method", "unsafe-error", "both-result-and-error", "id-mismatch", "redirect", "malformed-required-keyword", "negative-size-bound", "non-positive-multiple"],
    "boundary": ["absent-null-string-and-integral-id", "nullable-parameter", "kind-tagged-oneof", "scalar-result", "application-error-range"],
