  "vectors": [
    "forced-native-and-forced-pure",
    "escaped-duplicate-keys",
    "utf16-key-order",
    "lossless-scalars",
    "empty-object-versus-list",
    "numeric-looking-map-keys",
    "missing-null-and-partial-data",
    "stable-public-error-codes",
    "depth-node-byte-output-limits",
    "opaque-request-owned-representations",
    "immutable-request-owned-operation-plans",
    "fpm-same-worker-success-failure-tenant-isolation",
    "all-native-entry-points-normal-and-resource-starved-corpus",
    "fallback-with-extension-absent"
  ],
  "lifecycle": {
    "minit": "register-final-opaque-classes",
    "mshutdown": "no-persistent-cache",
    "rinit": "no-request-globals",
    "rshutdown": "object-destructors-own-request-data",
    "persistentState": false,
    "preemptiveCancellation": false,
    "fpmIsolation": "one-static-worker-three-requests-success-failure-tenant-change"
  },
