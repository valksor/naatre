    "buildModes": ["release", "debug"],
    "opcache": ["disabled", "enabled-jit-disabled", "enabled-jit-enabled"]
  },
  "capabilities": ["json-codec", "canonical-json", "semantic-hash", "document-representation", "operation-plan", "lossless-values", "structural-validation", "batch-canonical-json"],
