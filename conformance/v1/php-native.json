    "format": "naatre.php-native-benchmark-1",
    "minimumSamples": 30,
    "warmupRequired": true,
    "rawSamplesRequired": true,
    "primitives": ["parse-schema", "validate-structure", "canonicalize", "semantic-hash", "compile-plan", "repeated-execution-preparation", "sdk-round-trip", "persistent-worker-preparation", "php-native-boundary"],
    "nativeAllocationCount": "requires-platform-profiler",
    "defaultSelectionRequiresPublishedEvidence": true
  },
