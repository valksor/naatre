    {
      "name": "nested-explicit-map-and-list-metadata",
      "document": {
        "requires": ["core.language-1"],
        "operations": [{
          "name": "Users",
          "kind": "query",
          "select": [{
            "$call": {
              "name": "users",
              "select": [
                {"$meta": {"name": "count", "as": "total"}},
                {"$map": {"as": "items", "select": [
                  {"$field": {"name": "id"}},
                  {"$nest": {"as": "profile", "select": [
                    {"$field": {"name": "displayName", "as": "display"}}
                  ]}}
                ]}}
              ]
            }
          }]
        }]
      },
      "valid": true,
      "expectedData": {"users": {"total": 2, "items": [{"id": "u-1", "profile": {"display": "Ada"}}, {"id": "u-2", "profile": {"display": "Lin"}}]}}
    },
    {
      "name": "pipeline-prior-result-and-current",
      "document": {
        "operations": [{
          "name": "Profile",
          "kind": "query",
          "variables": [{"name": "id", "type": "ID"}],
          "select": [
            {"$call": {"name": "user", "args": {"id": {"$var": "id"}}, "bind": "user"}},
            {"$pipeline": {"as": "display", "stages": [
              {"$call": {"name": "useUser", "args": {"user": {"$result": "user"}}}},
              {"$field": {"name": "profile"}},
              {"$field": {"name": "displayName"}},
              {"$current": {}}
            ]}}
          ]
        }]
      },
      "valid": true,
      "requestVariables": {"id": "u-1"},
      "expectedData": {"user": {"id": "u-1"}, "display": "Ada"}
    },
    {
      "name": "collection-index-slice-page-and-current",
      "document": {
        "operations": [{
          "name": "Collections",
          "kind": "query",
          "select": [{
            "$call": {"name": "users", "select": [
              {"$index": {"as": "first", "at": 0, "select": [{"$field": {"name": "id"}}]}},
              {"$slice": {"as": "tail", "start": 1, "end": 99, "select": [{"$field": {"name": "id"}}]}},
              {"$page": {"as": "page", "first": 2, "select": [{"$field": {"name": "id"}}]}},
              {"$current": {"as": "raw"}}
            ]}
          }]
        }]
      },
      "valid": true,
      "capabilities": ["collection.page-1"],
      "expectedData": {"users": {"first": {"id": "u-1"}, "tail": [{"id": "u-2"}], "page": {"items": [{"id": "u-1"}, {"id": "u-2"}], "pageInfo": {"hasNextPage": false, "hasPreviousPage": false, "startCursor": "<opaque>", "endCursor": "<opaque>"}}, "raw": [{"id": "u-1"}, {"id": "u-2"}]}}
    },
    {
