  ],
  "handleBindings": ["principal", "tenant", "operationIdentity", "variableIdentity", "schemaRevision", "authorizationRevision", "limits", "createdAt", "expiresAt", "deliveryProfile"],
  "browserHandleFixture": {"path":"conformance/browser/subscription-handles.html","sha256":"3890b85a5c38d4d59eae8c0a047c6184bf727e11e2a5231a3a84d72a605e55f3","listener":"ephemeral-port","credentials":"same-origin-memory-only"},
