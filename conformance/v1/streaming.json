  "advertisementCases": [
    {
      "name": "no-replay-live",
      "advertisement": {"profileVersion":"1","replay":"none","consistency":"live-best-effort","retentionPolicy":"none","maxReplayEvents":0,"maxReplayBytes":0,"disclosesEarliestPosition":false,"historyRecovery":"restart"},
      "expected": "ok"
    },
    {
      "name": "bounded-snapshot",
      "advertisement": {"profileVersion":"1","replay":"bounded","consistency":"snapshot-stable","retentionPolicy":"process-memory-ttl","maxReplayEvents":128,"maxReplayBytes":1048576,"disclosesEarliestPosition":false,"historyRecovery":"refetch"},
      "expected": "ok"
    },
    {
      "name": "invalid-consistency",
      "advertisement": {"profileVersion":"1","replay":"none","consistency":"eventual","retentionPolicy":"none","maxReplayEvents":0,"maxReplayBytes":0,"disclosesEarliestPosition":false,"historyRecovery":"restart"},
      "expected": "invalid-advertisement"
    }
  ],
  "frameCases": [
    {
      "name": "duplicate-idempotent",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 2, "position": 1, "data": {"user": {"name": "Liiv"}}},
        {"type": "data", "stream": "s", "sequence": 2, "position": 1, "data": {"user": {"name": "Liiv"}}},
        {"type": "complete", "stream": "s", "sequence": 3}
      ],
      "expected": "ok",
      "expectedState": {"user":{"name":"Liiv"}}
    },
    {
      "name": "duplicate-conflict",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 2, "data": true},
        {"type": "data", "stream": "s", "sequence": 2, "data": false}
      ],
      "expected": "duplicate-conflict"
    },
    {
      "name": "sequence-gap",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 3, "data": true}
      ],
      "expected": "sequence-gap"
    },
    {
      "name": "position-order",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 2, "position": 2, "data": {"field": false}},
        {"type": "patch", "stream": "s", "sequence": 3, "position": 1, "path": ["field"], "data": true}
      ],
      "expected": "position-order"
    },
    {
      "name": "patch-before-parent",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "patch", "stream": "s", "sequence": 2, "position": 1, "path": ["missing", "child"], "data": true}
      ],
      "expected": "patch-order"
    },
    {
      "name": "patch-cannot-append-list-position",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 2, "data": [true]},
        {"type": "patch", "stream": "s", "sequence": 3, "position": 1, "path": [1], "data": false}
      ],
      "expected": "patch-order",
      "expectedState": [true]
    },
    {
      "name": "midstream-path-error",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 2, "data": {"user": {"name": "Liiv"}}},
        {"type": "error", "stream": "s", "sequence": 3, "path": ["user", "email"], "error": {"code": "SOURCE_UNAVAILABLE", "message": "email unavailable"}},
        {"type": "complete", "stream": "s", "sequence": 4}
      ],
      "expected": "ok",
      "expectedIssues": 1
    },
    {
      "name": "final-error-path",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "error", "stream": "s", "sequence": 2, "path": ["user","email"], "final": true, "error": {"code": "FAILED", "message": "stream failed"}}
      ],
      "expected": "ok",
      "expectedTerminal": "error",
      "expectedTerminalPath": ["user","email"]
    },
    {
      "name": "history-unavailable-recovery",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "history-unavailable", "stream": "s", "sequence": 2, "recovery": "refetch"}
      ],
      "expected": "ok",
      "expectedRecovery": "refetch"
    },
    {
      "name": "final-frame-lost",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 2, "data": true}
      ],
      "expected": "truncated"
    },
    {
      "name": "unknown-frame-type",
      "frames": [
        {"type": "open-v2", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"}
      ],
      "expected": "invalid-frame"
    },
    {
      "name": "open-sequence-not-one",
      "frames": [
        {"type": "open", "stream": "s", "sequence": 2, "schemaRevision": "schema-r1"}
      ],
      "expected": "invalid-frame"
    },
    {
      "name": "duplicate-expired",
      "trackedSequences": 1,
      "frames": [
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"},
        {"type": "data", "stream": "s", "sequence": 2, "position": 1, "data": {"value": true}},
        {"type": "patch", "stream": "s", "sequence": 3, "position": 2, "path": ["value"], "data": false},
        {"type": "open", "stream": "s", "sequence": 1, "schemaRevision": "schema-r1"}
      ],
      "expected": "duplicate-expired"
    }
  ],
