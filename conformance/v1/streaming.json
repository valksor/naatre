  "handleHandoffCases": [
    {"name":"mutation-after-snapshot-before-attach","snapshotPosition":1,"committedPositions":[2],"replayedPositions":[2],"livePositions":[3],"expectedPositions":[2,3],"duplicates":0,"gap":false}
  ],
  "adapterFixtures": [
    {"name":"in-process","frames":["open","data","patch","error","complete","keepalive","resume","history-unavailable"],"replay":"bounded","privateScopedDelivery":true,"replayAuthorization":true,"historyLossDetection":true,"terminalFrameRetention":true,"duplicateSuppression":true,"boundedRetry":true,"expected":"compatible"},
    {"name":"mercure-complete-mapping","frames":["open","data","patch","error","complete","keepalive","resume","history-unavailable"],"replay":"durable","privateScopedDelivery":true,"replayAuthorization":true,"historyLossDetection":true,"terminalFrameRetention":true,"duplicateSuppression":true,"boundedRetry":true,"expected":"compatible"},
    {"name":"mercure-public-topic-missing-terminal","frames":["data","patch"],"replay":"bounded","privateScopedDelivery":false,"replayAuthorization":false,"historyLossDetection":false,"terminalFrameRetention":false,"duplicateSuppression":false,"boundedRetry":false,"expected":"fidelity-failure"}
  ],
  "brokerFailureCases": [
    {"name":"broker-outage","expected":"delivery-interrupted","retry":"bounded"},
    {"name":"delayed-replay","expected":"not-caught-up-until-live-registered","retry":"bounded"},
    {"name":"duplicate-delivery","expected":"idempotent-or-conflict","retry":"bounded"},
    {"name":"reconnect","expected":"resume-or-explicit-refetch","retry":"bounded"},
    {"name":"terminal-frame-loss","expected":"truncated-not-complete","retry":"bounded"}
  ],
  "operationalCases": [
    {"name":"bounded-reconnect-ramp","maximumConnectionLifetime":"finite","reconnectStagger":"finite-less-than-lifetime","maximumReconnectAttempts":5,"expected":"caught-up-or-explicit-history-loss"},
    {"name":"synthetic-ingress-canary","data":"isolated-synthetic","steps":["establish","authorize","deliver","disconnect","resume","terminal"],"records":["bounded-stage","safe-outcome"],"forbiddenRecords":["credential","handle","cursor","payload","protected-revision"]}
