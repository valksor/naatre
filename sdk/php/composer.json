{
  "name": "naatre/sdk",
  "description": "Framework-neutral PHP client, generated bindings, and remote-worker server core for Naatre",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.5 <8.7",
    "ext-iconv": "*",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8",
    "phpstan/phpstan": "^2.1",
    "vimeo/psalm": "^6.0"
  },
  "suggest": {
    "naatre/naatre-ext": "Optional native accelerator (bounded JSON, RFC 8785 canonicalization, semantic hashing). Install with PIE: pie install naatre/naatre-ext. The client falls back to the pure-PHP implementation when it is absent."
  },
  "autoload": {
    "psr-4": {
      "Naatre\\Sdk\\": "src/"
    },
    "files": [
      "generated/Operations.php",
      "generated/Handlers.php"
    ]
  },
  "scripts": {
    "generate": "php sdkgen/generate.php ../../conformance/v1/generator-model.json ../../conformance/v1/generator-output.json generated/Operations.php generated/operations.json generated/Handlers.php",
    "test": "php tests/run.php",
    "test-adapters": "php tests/adapters.php",
    "test-server": "php tests/server.php",
    "test-worker-adapters": "php tests/worker-adapters.php",
    "test-native": "php tests/native.php",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "psalm": "psalm --no-cache --show-info=false",
    "check": [
      "@generate",
      "@test",
      "@test-adapters",
      "@test-server",
      "@test-worker-adapters",
      "@test-native",
      "@phpstan",
      "@psalm"
    ]
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  }
}
